# Public site origin — used to build absolute logo URLs in emails
NEXT_PUBLIC_BASE_URL=https://rodha.co.in

# Public website API (Postman {{baseUrl}} — include trailing slash)
NEXT_PUBLIC_API_BASE_URL=
# x-source header for public website APIs
NEXT_PUBLIC_API_SOURCE=website
# Announcement bar rotation interval (ms)
NEXT_PUBLIC_ANNOUNCEMENT_INTERVAL_MS=8000
# Optional server-only API key (omit if backend does not require it)
API_KEY=
# ISR revalidate window for API GETs (seconds)
API_REVALIDATE_SECONDS=60

# Server-only SMTP (recommended)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=noreply@rodha.co.in
EMAIL_FROM_NAME=Rodha
EMAIL_TO=support@rodha.co.in

# Google Identity Services (auth screen — Continue with Google)
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Authorized JavaScript origins: http://localhost:3000 and this site origin (NEXT_PUBLIC_BASE_URL).
# Authorized redirect URIs: same origins, plus /login and /signup if Console requires them.
# Consent screen scopes: email, profile, openid.
# Do not put a client secret in the browser. No GOOGLE_CLIENT_SECRET unless the backend switches to auth-code exchange.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
