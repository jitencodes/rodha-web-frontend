# Template only. Committed environment files (do not put passwords in them):
#   .env              development  NEXT_PUBLIC_API_BASE_URL=https://innowrap.co.in/rodha/
#   .env.production   production   NEXT_PUBLIC_API_BASE_URL=https://api.rodha.co.in/rodha/
# Secrets go in gitignored `.env.local` (EMAIL_SMTP_PASS, API_KEY).
# Builds select one file via scripts/select-env.mjs so Next cannot load both.
# See docs/DEPLOYMENT_GITLAB.md.

# Public site origin — used to build absolute logo URLs in emails
NEXT_PUBLIC_BASE_URL=https://rodha.co.in

# Public website API (Postman {{baseUrl}} — include trailing slash)
NEXT_PUBLIC_API_BASE_URL=
# x-source header for public website APIs
NEXT_PUBLIC_API_SOURCE=website
# Announcement bar rotation interval (ms)
NEXT_PUBLIC_ANNOUNCEMENT_INTERVAL_MS=8000
# Optional server-only API key (omit if backend does not require it)
API_KEY=
# ISR revalidate window for API GETs (seconds)
API_REVALIDATE_SECONDS=60

# Server-only SMTP (recommended)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=noreply@rodha.co.in
EMAIL_FROM_NAME=Rodha
# Inbound support inbox (SMTP destination). Defaults to NEXT_PUBLIC_SUPPORT_EMAIL.
EMAIL_TO=contactus@rodha.co.in

# Public support email shown in Footer, Contact, account help mailto links
NEXT_PUBLIC_SUPPORT_EMAIL=contactus@rodha.co.in

# Google Identity Services (auth screen — Continue with Google)
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Authorized JavaScript origins (scheme + host only, no path):
#   http://localhost:3000
#   https://rodha-web-frontend.vercel.app   ← required for Vercel preview/prod URL
#   https://rodha.co.in
#   https://www.rodha.co.in
# Authorized redirect URIs: same origins, plus /login and /signup if Console requires them.
# Consent screen scopes: email, profile, openid.
# NEXT_PUBLIC_* is baked at build time — after changing Vercel/GitLab env, redeploy.
# Do not put a client secret in the browser. No GOOGLE_CLIENT_SECRET unless the backend switches to auth-code exchange.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Default public home path (`/` redirects here). Set to `/` to serve the homepage at root.
NEXT_PUBLIC_DEFAULT_HOME_PATH=/category/cat

# Account header — Take Test (Think Exam)
NEXT_PUBLIC_THINK_EXAM_URL=

# Live Classroom / Graphy dashboard (SSO token appended client-side as ?ssoToken=)
# Prefer this over the obsolete NEXT_PUBLIC_DASHBOARD_GRAPHY_URL placeholder.
NEXT_PUBLIC_GRAPHY_DASHBOARD_URL=https://rodha.graphy.com/t/u/activeCourses

# Category hero icon CTAs (WhatsApp community + brochure PDF)
NEXT_PUBLIC_CAT_COMMUNITY_URL=
NEXT_PUBLIC_BROCHURE_URL=

# Meta Pixel (Purchase event on /account/checkout/success when set)
NEXT_PUBLIC_META_PIXEL_ID=