# Production defaults (branch: production, Docker APP_ENV=production, Vercel production).
# `next build` loads this file whenever NODE_ENV=production, so development
# builds must delete it first (scripts/select-env.mjs) or the prod API URL wins.
# Do not put SMTP passwords or API keys here.

NEXT_PUBLIC_BASE_URL=https://rodha.co.in
NEXT_PUBLIC_API_BASE_URL=https://api.rodha.co.in/rodha/
NEXT_PUBLIC_API_SOURCE=website
NEXT_PUBLIC_ANNOUNCEMENT_INTERVAL_MS=3000
NEXT_PUBLIC_DEFAULT_HOME_PATH=/category/cat
NEXT_PUBLIC_EMAIL_LOGO_URL=https://github.com/jitencodes/rodha-web-frontend/blob/main/public/assets/images/rodha-logo.webp?raw=true
NEXT_PUBLIC_SUPPORT_EMAIL=contactus@rodha.co.in
API_REVALIDATE_SECONDS=60

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=noreply@rodha.co.in
EMAIL_FROM=noreply@rodha.co.in
EMAIL_FROM_NAME=Rodha
EMAIL_TO=contactus@rodha.co.in

NEXT_PUBLIC_GRAPHY_DASHBOARD_URL=https://rodha.graphy.com/t/u/activeCourses
NEXT_PUBLIC_RODHA_BUDDY_URL=https://buddy.rodha.co.in
NEXT_PUBLIC_THINK_EXAM_URL=https://mocks.rodha.co.in/
NEXT_PUBLIC_CAT_COMMUNITY_URL=https://chat.whatsapp.com/D235gSA7Fsy7oWOgSgRnku
