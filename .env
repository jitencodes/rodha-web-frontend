# Development defaults (branch: main, local `next dev`, Docker APP_ENV=development).
# Production builds use `.env.production` instead — see scripts/select-env.mjs.
# Do not put SMTP passwords or API keys here. Those belong in gitignored `.env.local`
# or in GitLab CI/CD variables (EMAIL_SMTP_PASS, API_KEY).

