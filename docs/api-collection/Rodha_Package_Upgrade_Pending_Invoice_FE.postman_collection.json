          "response": [
            {
              "name": "200 PAID pdf still generating",
              "originalRequest": {
                "method": "GET",
                "url": "{{baseUrl}}api/website/student/orders/46"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"Order fetched successfully\",\n  \"data\": {\n    \"id\": 46,\n    \"orderNumber\": \"ORD-MWX5OQBS-35DC97\",\n    \"status\": \"PAID\",\n    \"kind\": \"PURCHASE\",\n    \"payableAmount\": 9199.2,\n    \"invoices\": [\n      {\n        \"id\": 21,\n        \"invoiceNumber\": \"INV-46-MWX5PERK8A37\",\n        \"pdfUrl\": null\n      }\n    ]\n  }\n}"
            },
            {
              "name": "200 PAID pdf ready",
              "originalRequest": {
                "method": "GET",
                "url": "{{baseUrl}}api/website/student/orders/46"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"Order fetched successfully\",\n  \"data\": {\n    \"id\": 46,\n    \"orderNumber\": \"ORD-MWX5OQBS-35DC97\",\n    \"status\": \"PAID\",\n    \"kind\": \"PURCHASE\",\n    \"payableAmount\": 9199.2,\n    \"invoices\": [\n      {\n        \"id\": 21,\n        \"invoiceNumber\": \"INV-46-MWX5PERK8A37\",\n        \"pdfUrl\": \"https://rodha-dev-bucket.s3.ap-south-1.amazonaws.com/website/invoices/…INV-46….pdf\"\n      }\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "POST retry-fulfill (re-queue PDF)",
          "request": {
            "method": "POST",
            "header": [{ "key": "x-source", "value": "Postman", "type": "text" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{studentAccessToken}}", "type": "string" }]
            },
            "url": "{{baseUrl}}api/website/student/orders/{{paidOrderId}}/retry-fulfill",
            "description": "Safe for PAID orders missing enrollment repair and/or missing invoice PDF (re-enqueues invoice-pdf job)."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}api/website/student/orders/46/retry-fulfill"
              },
              "status": "OK",
              "code": 200,
